# Environments
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# Data: raw jsonl and the feature cache are 44 GB and are rebuilt by
# `run_all.py --steps data`. Only the small split artefacts are committed, so a
# fresh machine can check that its rebuilt splits match row for row.
data/*
!data/splits/

# Large or regenerable model artefacts
models/*.bin
models/autogluon/
models/autogluon_quick/
# Quick-run (smoke test) H2O and AutoGluon folders anywhere under models/: H2O names its
# leaders with timestamps, so each quick run would otherwise add new untracked folders.
models/**/h2o_quick/
models/**/autogluon_quick/
models/refit_v1/
AutogluonModels/
catboost_info/
third_party/

# Local-only archive of work that was set aside (see docs/handoff/HANDOFF.md)
_archive/
